{
  "name": "@ccr/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches Claude Code sessions, normalizes them, and syncs them to the relay repo",
  "main": "./dist/index.js",
  "bin": {
    "ccr": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "dev": "node --watch ./dist/index.js",
    "ccr": "node ./dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ccr/shared": "*",
    "chokidar": "^4.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
