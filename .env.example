# Copy to `.env` and fill in. `.env` is gitignored — never commit the token.

# --- Relay repo -------------------------------------------------------------
# The private Gitee repository used as the mailbox. Both directions use it.
CCR_REPO_URL=https://gitee.com/thomaszhang0730/cccli_remote_data.git

# Personal access token for the repo above.
#
# This token is effectively PC-admin: a prompt written to the repo is injected
# into an agent that can run shell commands. Scope it to this one repository.
CCR_REPO_TOKEN=

# Two branches, deliberately.
#
# Outbound is amended and force-pushed so the repository does not accumulate a
# commit every few seconds. Inbound is append-only and never rewritten, because
# rewriting it would destroy a prompt the phone had written but the bridge had
# not yet fetched — silently. They cannot share a branch.
CCR_OUT_BRANCH=relay-out
CCR_IN_BRANCH=relay-in

# --- Prompt signing ---------------------------------------------------------
# Shared secret for HMAC-signing prompts sent from the phone. An unsigned,
# stale, or replayed prompt is rejected.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CCR_SECRET=

# --- Local state ------------------------------------------------------------
# Where tail offsets and chunk bookkeeping are persisted, so a restart resumes
# without duplicating or skipping events.
CCR_STATE_DIR=.ccr-state

# --- Cadence ----------------------------------------------------------------
# Gitee charges quota even for 304 Not Modified responses, and an authenticated
# request carries no rate-limit headers — so there is no remaining-allowance
# figure to read. Backoff is reactive, on 429/403, rather than predictive.
#
# `CCR_PUSH_MIN_MS` is a *floor* between publishes, not a schedule. Publishing is
# driven by turn boundaries and attention signals; this only coalesces the bursts
# those produce.
CCR_PUSH_MIN_MS=10000
CCR_POLL_MS=10000

# --- Scope ------------------------------------------------------------------
# Only sessions the bridge can inject into are controllable. Everything else is
# tailed read-only.
#
# Leave this false unless you have read docs/KNOWN-ISSUES.md. Injecting while a
# permission dialog is open answers the dialog rather than typing the prompt, so
# the bridge refuses to type into a session that is mid-turn or sitting behind
# one. With hooks installed that is decided from the hooks themselves; without
# them it falls back to the transcript rule, which refuses more often.
CCR_ALLOW_INJECTION=false

# --- Phone page build-time defaults -----------------------------------------
# Pre-fills the phone's settings screen. Only `VITE_*` values reach the built
# page, and these three are not secrets.
#
# Do NOT add the token or the signing secret. The page is served from a public
# URL, so anything baked in is readable by anyone who loads it — and that token
# reads every relayed session and can write prompts to the PC.
VITE_CCR_OWNER=
VITE_CCR_REPO=
VITE_CCR_POLL_MS=15000

# --- Hooks (optional) -------------------------------------------------------
# Hooks let the bridge know authoritatively when a tool call is in flight or a
# permission dialog is open, instead of inferring it from the transcript. The
# transcript rule still applies when these are absent, so the bridge works
# without them -- it is just less precise about when a prompt may be typed in.
#
# Run `node scripts/install-hooks.mjs` to see what it would write; add --write to
# apply it. It defaults to project-level settings and backs up before writing.
#
# The port is deliberately low and uncommon. The receiver binds loopback only.
CCR_HOOK_PORT=27182
# Generated by the installer. The hook command in settings.json carries no
# secret itself; the forwarder reads it from here, so the two cannot disagree.
CCR_HOOK_TOKEN=
# How long a transcript may run ahead of the last hook event before hooks stop
# being trusted for that session.
CCR_HOOK_QUIET_MS=120000
